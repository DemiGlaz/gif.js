function setup() {
  createCanvas(800, 400);
  textSize(60);
  textStyle(BOLD);
  textAlign(CENTER, CENTER);
  noLoop();
}

function draw() {
  background(0);
  
  // Цвета для градиента
  let colors = [
    color(255, 100, 0),
    color(255, 200, 0),
    color(255, 255, 0),
    color(0, 255, 255),
    color(0, 100, 255),
    color(255, 0, 255)
  ];
  
  // Рисуем текст с эффектом огня
  for (let i = 0; i < 10; i++) {
    fill(colors[i % colors.length]);
    text("Елена Strategy", width / 2 + random(-5, 5), height / 2 + random(-5, 5));
  }
  
  // Добавляем киберпанк-элементы
  stroke(0, 255, 255);
  strokeWeight(2);
  noFill();
  for (let i = 0; i < 10; i++) {
    ellipse(width / 2 + random(-20, 20), height / 2 + random(-20, 20), 50 + i * 10, 50 + i * 10);
  }
  
  // Добавляем эффект "огня" вокруг текста
  for (let i = 0; i < 100; i++) {
    let x = random(width);
    let y = random(height);
    let size = random(5, 20);
    fill(255, random(100, 255), 0, random(100, 200));
    noStroke();
    ellipse(x, y, size, size);
  }
}
